# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Build and tool entries are not anchored, so they apply in every workspace (spec 0008).

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build/

# turborepo
.turbo/

# generated Prisma client (pnpm turbo run db:generate)
packages/db/src/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
playwright-report
test-results
blob-report
