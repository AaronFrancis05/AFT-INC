# Copy to .env and fill in real values. Never commit .env.
# Every variable the app reads today. Scope feature 6 (typed environment config)
# turns this list into a validated schema that fails fast at startup.

# --- Database (Postgres) -----------------------------------------------------
# Local: postgres running on your machine (scope feature 8 adds docker compose).
# Production: AWS RDS, created by scope feature 12. Never point local dev at production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aft"

# --- Auth (Better Auth) ------------------------------------------------------
# A random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# The public base URL of the app.
BETTER_AUTH_URL="http://localhost:3000"

# --- Social sign in (optional) ---------------------------------------------
# Leave empty to disable a provider. Create credentials at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers  (OAuth Apps)
# Callback URL for both: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Email (Resend) ----------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev when empty.
RESEND_FROM_EMAIL=""
