# Copy to .env and fill in real values. Never commit .env.
# Every variable the apps read. Each one is declared once in a package env slice
# (@aft/<pkg>/env, spec 0010) and checked when the server starts: a missing or wrong
# value stops it with a list of every problem. A contract test keeps this file, the
# schema, and turbo.json globalEnv listing the same names.

# --- Environment -------------------------------------------------------------
# Which environment this is: development on your machine, test in CI, production on
# the server. Required, with no default; production turns on the strict rules (spec 0010).
AFT_ENV="development"

# --- Database (Postgres) -----------------------------------------------------
# Local: postgres running on your machine (scope feature 8 adds docker compose).
# Production: AWS RDS, created by scope feature 12. Never point local dev at production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aft"

# --- Auth (Better Auth) ------------------------------------------------------
# A random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# The public base URL of the app. The server uses it for OAuth callbacks and trusted origins.
# The browser does not read it: the auth client calls /api/auth on the page's own origin.
BETTER_AUTH_URL="http://localhost:3000"

# --- Social sign in (optional) ---------------------------------------------
# A provider turns on only when both its ID and its secret are set. Leave both empty to turn it off.
# Setting only one logs a warning and keeps the provider off. Create credentials at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers  (OAuth Apps)
# Callback URL for both: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Email (Resend) ----------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev when empty.
RESEND_FROM_EMAIL=""
