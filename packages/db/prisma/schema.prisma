generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("user")
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Who sent an idempotent call (spec 0011).
enum IdempotencyOwnerKind {
  user
  api_key

  @@map("idempotency_owner_kind")
}

// One saved reply per caller, workspace, scope, and key, for 24 hours (spec 0011, AC-4). No row
// level security: reached only through @aft/db/idempotency, which always filters by the full owner.
model IdempotencyRecord {
  id             String               @id @default(uuid(7)) @db.Uuid
  ownerKind      IdempotencyOwnerKind
  ownerId        String
  organizationId String               @default("")
  scope          String
  key            String
  fingerprint    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime             @db.Timestamptz(3)

  @@unique([ownerKind, ownerId, organizationId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}
